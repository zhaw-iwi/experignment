# Copy this file to .env and replace every placeholder before deployment.
EXPERIMENT_DB_HOST=db.example.invalid
EXPERIMENT_DB_PORT=3306
EXPERIMENT_DB_NAME=experiment_assignment
EXPERIMENT_DB_CHARSET=utf8mb4
EXPERIMENT_DB_USER=experiment_assignment
EXPERIMENT_DB_PASSWORD=replace-with-a-secret

# Generate this hash with the provisioning helper added by the authentication milestone.
ADMIN_ACCESS_CODE_HASH=replace-with-a-password-hash
ADMIN_SESSION_IDLE_SECONDS=7200
STUDENT_SESSION_IDLE_SECONDS=28800
APP_SESSION_NAME=experiment_assignment_v3
APP_SESSION_SECURE=true
