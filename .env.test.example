# Copy this file to .env.test and replace the placeholders there.
# Never put real credentials in this tracked example file.
# Select the local file explicitly before running a command:
#   PowerShell: $env:EXPERIMENT_ENV_FILE='.env.test'
#   Bash:       EXPERIMENT_ENV_FILE=.env.test php ...

# Use a dedicated empty/disposable database, never the live database.
EXPERIMENT_DB_HOST=127.0.0.1
EXPERIMENT_DB_PORT=3306
EXPERIMENT_DB_NAME=experiment_assignment_test
EXPERIMENT_DB_CHARSET=utf8mb4
EXPERIMENT_DB_USER=replace-with-local-test-user
EXPERIMENT_DB_PASSWORD=replace-with-local-test-password

# Set this to true only when this database may be reset/dropped during QA.
EXPERIMENT_TEST_DATABASE_RESET_ALLOWED=false

# Generate a local-only code/hash pair with scripts/generate_admin_access_code.php.
ADMIN_ACCESS_CODE_HASH=replace-with-a-password-hash
ADMIN_SESSION_IDLE_SECONDS=7200
STUDENT_SESSION_IDLE_SECONDS=28800
APP_SESSION_NAME=experiment_assignment_v3_test

# Keep false for a local HTTP server. Production must use true over HTTPS.
APP_SESSION_SECURE=false
APP_TIMEZONE=Europe/Zurich
